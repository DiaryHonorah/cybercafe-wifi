CREATE DATABASE gestion_demandes_eni
    WITH ENCODING = 'UTF8';
/* ============================================================
   PROJET : GESTION DES DEMANDES ADMINISTRATIVES DES ETUDIANTS
   ETABLISSEMENT : ENI
   SGBD : POSTGRESQL
   METHODE DE CONCEPTION : MERISE

   BASE DE DONNEES : gestion_demandes_eni

   IMPORTANT :
   Exécuter ce script dans une base vide.
   Ce script ne supprime aucune table existante.
   ============================================================ */


/* ============================================================
   1. TABLE NIVEAU
   ============================================================ */

BEGIN;

CREATE TABLE niveau (
    code_niveau VARCHAR(4) PRIMARY KEY,
    libelle_niveau VARCHAR(50) NOT NULL
);


/* ============================================================
   2. TABLE MENTION
   ============================================================ */

CREATE TABLE mention (
    code_mention VARCHAR(4) PRIMARY KEY,
    nom_mention VARCHAR(10) NOT NULL
);


/* ============================================================
   3. TABLE PARCOURS
   Association : PROPOSER
   ============================================================ */

CREATE TABLE parcours (
    code_parcours VARCHAR(4) PRIMARY KEY,
    nom_parcours VARCHAR(20) NOT NULL,
    code_mention VARCHAR(4) NOT NULL UNIQUE,

    CONSTRAINT fk_parcours_mention
        FOREIGN KEY (code_mention)
        REFERENCES mention(code_mention)
);


/* ============================================================
   4. TABLE GROUPE
   ============================================================ */

CREATE TABLE groupe (
    code_groupe VARCHAR(4) PRIMARY KEY,
    libelle_groupe VARCHAR(50) NOT NULL
);


/* ============================================================
   5. TABLE ANNEE_UNIVERSITAIRE
   ============================================================ */

CREATE TABLE annee_universitaire (
    code_annee VARCHAR(15) PRIMARY KEY,
    libelle_annee VARCHAR(10) NOT NULL
);


/* ============================================================
   6. TABLE ETUDIANT
   ============================================================ */

CREATE TABLE etudiant (
    num_matricule VARCHAR(8) PRIMARY KEY,
    nom VARCHAR(50) NOT NULL,
    prenom VARCHAR(20) NOT NULL,
    numero_telephone VARCHAR(15),
    email VARCHAR(50),
    adresse VARCHAR(50)
);


/* ============================================================
   7. TABLE INSCRIPTION

   Associations :
   - EFFECTUER : ETUDIANT
   - CORRESPONDRE : NIVEAU
   - ORIENTER : PARCOURS
   - CLASSER : GROUPE
   - COUVRIR : ANNEE_UNIVERSITAIRE
   ============================================================ */

CREATE TABLE inscription (
    code_inscription VARCHAR(20) PRIMARY KEY,
    date_inscription DATE NOT NULL,

    num_matricule VARCHAR(8) NOT NULL,
    code_niveau VARCHAR(4) NOT NULL,
    code_parcours VARCHAR(4) NOT NULL,
    code_groupe VARCHAR(4) NOT NULL,
    code_annee VARCHAR(15) NOT NULL,

    CONSTRAINT fk_inscription_etudiant
        FOREIGN KEY (num_matricule)
        REFERENCES etudiant(num_matricule),

    CONSTRAINT fk_inscription_niveau
        FOREIGN KEY (code_niveau)
        REFERENCES niveau(code_niveau),

    CONSTRAINT fk_inscription_parcours
        FOREIGN KEY (code_parcours)
        REFERENCES parcours(code_parcours),

    CONSTRAINT fk_inscription_groupe
        FOREIGN KEY (code_groupe)
        REFERENCES groupe(code_groupe),

    CONSTRAINT fk_inscription_annee
        FOREIGN KEY (code_annee)
        REFERENCES annee_universitaire(code_annee)
);


/* ============================================================
   8. TABLE TYPE_DEMANDE
   ============================================================ */

CREATE TABLE type_demande (
    num_type BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    libelle_type VARCHAR(100) NOT NULL,
    description VARCHAR(300)
);


/* ============================================================
   9. TABLE DEMANDE

   Associations :
   - CATEGORISER : TYPE_DEMANDE
   - CONCERNER : ANNEE_UNIVERSITAIRE
   - SOUMETTRE : ETUDIANT, via la table SOUMETTRE
   - SUIVRE : STATUT_DEMANDE, via la table SUIVRE
   - RENSEIGNER : CHAMP_DEMANDE, via la table RENSEIGNER
   ============================================================ */

CREATE TABLE demande (
    reference VARCHAR(20) PRIMARY KEY,
    objet_demande VARCHAR(150) NOT NULL,
    description_demande VARCHAR(300),
    motif_demande VARCHAR(150),
    date_demande DATE NOT NULL DEFAULT CURRENT_DATE,

    code_annee VARCHAR(15) NOT NULL,
    num_type BIGINT NOT NULL,

    CONSTRAINT fk_demande_annee
        FOREIGN KEY (code_annee)
        REFERENCES annee_universitaire(code_annee),

    CONSTRAINT fk_demande_type
        FOREIGN KEY (num_type)
        REFERENCES type_demande(num_type)
);


/* ============================================================
   10. TABLE STATUT_DEMANDE
   ============================================================ */

CREATE TABLE statut_demande (
    statut VARCHAR(20) PRIMARY KEY,
    libelle_statut VARCHAR(50) NOT NULL
);


/* ============================================================
   11. TABLE CHAMP_DEMANDE

   Association : DEFINIR
   Un type de demande peut définir plusieurs champs.
   Chaque champ appartient à un seul type de demande.
   ============================================================ */

CREATE TABLE champ_demande (
    nom_champs VARCHAR(20) PRIMARY KEY,
    libelle_champ VARCHAR(30) NOT NULL,
    type_champ VARCHAR(30) NOT NULL,
    obligatoire BOOLEAN NOT NULL DEFAULT FALSE,
    ordre INTEGER NOT NULL DEFAULT 1,

    num_type BIGINT NOT NULL,

    CONSTRAINT fk_champ_type
        FOREIGN KEY (num_type)
        REFERENCES type_demande(num_type),

    CONSTRAINT chk_champ_ordre
        CHECK (ordre > 0)
);


/* ============================================================
   12. TABLE SOUMETTRE

   Association entre ETUDIANT et DEMANDE.
   ============================================================ */

CREATE TABLE soumettre (
    num_matricule VARCHAR(8) NOT NULL,
    reference VARCHAR(20) NOT NULL,

    CONSTRAINT pk_soumettre
        PRIMARY KEY (num_matricule, reference),

    CONSTRAINT fk_soumettre_etudiant
        FOREIGN KEY (num_matricule)
        REFERENCES etudiant(num_matricule),

    CONSTRAINT fk_soumettre_demande
        FOREIGN KEY (reference)
        REFERENCES demande(reference)
);


/* ============================================================
   13. TABLE SUIVRE

   Association entre DEMANDE et STATUT_DEMANDE.
   L'attribut DATE conserve la date du suivi.
   ============================================================ */

CREATE TABLE suivre (
    reference VARCHAR(20) NOT NULL,
    statut VARCHAR(20) NOT NULL,
    date DATE NOT NULL DEFAULT CURRENT_DATE,

    CONSTRAINT pk_suivre
        PRIMARY KEY (reference, statut, date),

    CONSTRAINT fk_suivre_demande
        FOREIGN KEY (reference)
        REFERENCES demande(reference),

    CONSTRAINT fk_suivre_statut
        FOREIGN KEY (statut)
        REFERENCES statut_demande(statut)
);


/* ============================================================
   14. TABLE RENSEIGNER

   Association entre DEMANDE et CHAMP_DEMANDE.
   L'attribut VALEUR_DEMANDE conserve la valeur saisie.
   ============================================================ */

CREATE TABLE renseigner (
    reference VARCHAR(20) NOT NULL,
    nom_champs VARCHAR(20) NOT NULL,
    valeur_demande VARCHAR(200),

    CONSTRAINT pk_renseigner
        PRIMARY KEY (reference, nom_champs),

    CONSTRAINT fk_renseigner_demande
        FOREIGN KEY (reference)
        REFERENCES demande(reference),

    CONSTRAINT fk_renseigner_champ
        FOREIGN KEY (nom_champs)
        REFERENCES champ_demande(nom_champs)
);


/* ============================================================
   15. INDEX POUR FACILITER LES RECHERCHES
   ============================================================ */

CREATE INDEX idx_etudiant_nom
    ON etudiant(nom);

CREATE INDEX idx_demande_date
    ON demande(date_demande);

CREATE INDEX idx_demande_annee
    ON demande(code_annee);

CREATE INDEX idx_demande_type
    ON demande(num_type);

CREATE INDEX idx_inscription_etudiant
    ON inscription(num_matricule);

CREATE INDEX idx_suivre_date
    ON suivre(date);


/* ============================================================
   16. INSERTION DES STATUTS DE REFERENCE
   ============================================================ */

INSERT INTO statut_demande (statut, libelle_statut)
VALUES
    ('ATTENTE', 'En attente'),
    ('TRAITEMENT', 'En cours de traitement'),
    ('COMPLETER', 'À compléter'),
    ('ACCEPTEE', 'Acceptée'),
    ('REFUSEE', 'Refusée'),
    ('ARCHIVEE', 'Archivée');


/* ============================================================
   17. INSERTION DES TYPES DE DEMANDES DE REFERENCE
   ============================================================ */

INSERT INTO type_demande (libelle_type, description)
VALUES
    (
        'Révision de note',
        'Demande de révision d une note obtenue'
    ),
    (
        'Suspension',
        'Demande de suspension des activités pédagogiques'
    ),
    (
        'Reprise ou réintégration',
        'Demande de reprise des études ou de réintégration'
    ),
    (
        'Absence',
        'Demande relative à une absence'
    ),
    (
        'Attestation',
        'Demande de délivrance d une attestation'
    ),
    (
        'Autre demande',
        'Autre demande administrative'
    );


COMMIT;


/* ============================================================
   18. VERIFICATION DES TABLES
   ============================================================ */

SELECT table_name
FROM information_schema.tables
WHERE table_schema = 'public'
  AND table_type = 'BASE TABLE'
ORDER BY table_name;


/* ============================================================
   19. VERIFICATION DES STATUTS
   ============================================================ */

SELECT statut, libelle_statut
FROM statut_demande
ORDER BY statut;


/* ============================================================
   20. VERIFICATION DES TYPES DE DEMANDES
   ============================================================ */

SELECT num_type, libelle_type, description
FROM type_demande
ORDER BY num_type;


/* ============================================================
   FIN DU SCRIPT
   ============================================================ */
